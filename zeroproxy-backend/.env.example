# Copy this file to .env and fill in your PostgreSQL password.

# API port (the Angular dev server proxies /api to this port)
PORT=3000

# Secret used to sign login tokens. Change it to any long random text.
JWT_SECRET=change-this-to-a-long-random-secret

# Secret the camera machine sends in the X-Device-Key header when it reports a scan.
DEVICE_KEY=change-this-to-a-long-random-key

# PostgreSQL connection. The database is created automatically if it does not exist.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=zeroproxy

# Email to parents when a child is late or absent. Leave SMTP_HOST empty to send no email.
# Gmail: SMTP_HOST=smtp.gmail.com, and SMTP_PASSWORD is an app password (not your Gmail password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The address emails come from, for example ZeroProxy <you@gmail.com>. Defaults to SMTP_USER.
SMTP_FROM=
