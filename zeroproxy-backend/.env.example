# Copy this file to .env and fill in your PostgreSQL password.

# API port (the Angular dev server proxies /api to this port)
PORT=3000

# Secret used to sign login tokens. Change it to any long random text.
JWT_SECRET=change-this-to-a-long-random-secret

# Secret the camera machine sends in the X-Device-Key header when it reports a scan.
DEVICE_KEY=change-this-to-a-long-random-key

# PostgreSQL connection. The database is created automatically if it does not exist.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=zeroproxy
